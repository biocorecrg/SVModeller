manifest {
    name            = 'simulate_wgs_data'
    author          = 'Ismael Vera-Munoz, Luca Cozzuto'
    description     = 'Sub-clonal WGS read simulation and alignment from reference and modified haplotype genomes'
    version         = '0.5.0'
    nextflowVersion = '!>=26.04.1'
    mainScript      = 'main.nf'
}

plugins {
    id 'nf-slack@0.5.0'
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

params {
    // Inputs
    ref_fasta               = null
    modified_genome         = null

    // Read simulation options
    method_file             = null
    sim_method              = "qshmm"
    coverage                = 30
    allele_frequency        = 0.5
    technology              = "HiFi"

    // Container
    container               = 'ghcr.io/biocorecrg/svmodeller:0.5.0'

    // Boilerplate options
    outdir                  = 'results'
    monochrome_logs         = false
    slack_url               = null
}

process {
    container = params.container
}

profiles {
    crg {
        includeConfig '../conf/modules.config'
        includeConfig '../conf/crg.config'
        includeConfig '../conf/cost.config'
    }
    applecontainer {
        includeConfig '../conf/modules.config'
        includeConfig '../conf/applecontainer.config'
    }
    appledocker {
        includeConfig '../conf/modules.config'
        includeConfig '../conf/appledocker.config'
    }
    standard {
        includeConfig '../conf/base.config'
        includeConfig '../conf/modules.config'
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        includeConfig '../conf/base.config'
        includeConfig '../conf/modules.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        includeConfig '../conf/base.config'
        includeConfig '../conf/modules.config'
    }
    test {
        includeConfig '../conf/base.config'
        includeConfig '../conf/modules.config'

        params.ref_fasta        = "../pipeline_inputs/chm13v2.0.chr20.fa.gz"
        params.modified_genome  = "../results/module4/Modified_Reference_Genome.fasta.gz"
        params.sim_method       = "qshmm"
        params.coverage         = 30
        params.allele_frequency = 0.5
        params.technology       = "HiFi"
    }
}

docker.registry = "quay.io"
singularity.registry = "quay.io"
singularity.pullTimeout = 1.h

