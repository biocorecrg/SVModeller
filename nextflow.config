manifest {
    // Trigger build for gzip import fix
    name            = 'SVModeller'
    author          = 'Ismael Vera-Munoz, Luca Cozzuto'
    description     = 'Simulation of synthetic human haplotypes containing embedded structural variants'
    version         = '0.5.0'
    nextflowVersion = '!>=26.04.1'
    mainScript      = 'main.nf'
}

plugins {
    id 'nf-slack@0.5.0'
}



env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

params {
    // Inputs
    vcf_insertions          = null
    vcf_deletions           = null
    ref_fasta               = null
    consensus               = null
    source_l1               = null
    source_sva              = null
    motifs                  = null
    sva_vntr                = null

    // Options
    num_events              = 10
    bin_size                = 1000000

    // Module 5 Options
    method_file             = null
    sim_method              = null
    coverage                = null
    allele_frequency        = null
    technology              = null

    // Boilerplate options
    outdir                  = 'results'
    monochrome_logs         = false
    slack_url               = null
}

profiles {
    crg {
        includeConfig 'conf/modules.config'
        includeConfig 'conf/crg.config'
    }
    applecontainer {
        includeConfig 'conf/modules.config'
        includeConfig 'conf/applecontainer.config'
    }
    appledocker {
        includeConfig 'conf/modules.config'
        includeConfig 'conf/appledocker.config'
    }
    standard {
        includeConfig 'conf/base.config'
        includeConfig 'conf/modules.config'
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        includeConfig 'conf/base.config'
        includeConfig 'conf/modules.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        includeConfig 'conf/base.config'
        includeConfig 'conf/modules.config'
    }
    test {
        includeConfig 'conf/base.config'
        includeConfig 'conf/modules.config'

        params.vcf_insertions = "test_data/VCF_Insertions.vcf"
        params.vcf_deletions  = "test_data/VCF_Deletions.vcf"
        params.chr_length     = "test_data/chr_length.txt"
        params.ref_fasta      = "test_data/toy_ref.fa"
        params.consensus      = "test_data/consensus_sequences_complete.fa"
        params.number_events  = "test_data/Number_events.tsv"
        params.source_l1      = "test_data/source_loci_LINE1.tsv"
        params.source_sva     = "test_data/source_loci_SVA.tsv"
        params.motifs         = "test_data/VNTR_with_start_position.txt"
        params.sva_vntr       = "test_data/SVA_VNTR_Motifs.txt"
        params.num_events     = 10
        params.bin_size       = 1000000
        params.sim_method     = "qshmm"
        params.coverage       = 30
        params.allele_frequency = 0.5
    }
}

docker.registry = "quay.io"
singularity.registry = "quay.io"
singularity.pullTimeout = 1.h
